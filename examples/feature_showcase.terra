-- Terra feature showcase
-- Run with: ./run.sh run examples/feature_showcase.terra hello from terra

temp region(3);

struct ShowcasePlayer {
  String name;
  Int score;
}

enum ShowcaseStatus {
  variant Ready(Int code);
  variant Failed(String message);
  variant Waiting;
}

const Int showcase_base = 4;
global String showcase_name = "Terra";

function Int Factorial(Int n) {
  if n <= 1 {
    return 1;
  }
  return n * Factorial(n - 1);
}

function Int SumTo(Int n, Int total) {
  if n <= 0 {
    return total;
  }
  return SumTo(n - 1, total + n);
}

function (String, Number) Analyze(Int value) {
  if value > 10 {
    return "large", value * 2;
  } elseif value > 5 {
    return "medium", value * 2;
  } else {
    return "small", value * 2;
  }
}

function Number Banner() {
  stdout("=== Terra on the BEAM VM ===");
  return 1;
}

function Int Increment(Int value) {
  return value + 1;
}

function strict *SInt Main(*String Args) {
  -- Fixed entry point and command-line arguments.
  stdout("Main received:");
  stdout(Args.*);

  -- Once-only calls run once even when written twice.
  Banner;
  Banner;

  -- Normal calls run every time.
  Banner();
  Banner();

  -- Variable scopes, evaluation modes, and concurrency markers.
  global State state = State();
  local const Int base = showcase_base;
  local computed Int total = base + 3;
  local lazy Number delayed = Factorial(4);
  local atomic Int counter = 1;
  local thread_local String session = "local-session";
  local Var inferred = 99;
  temp Float ratio = 10.5;
  local SInt debt = -5;
  local Atom status = :ready;
  local Bool enabled = true;
  local *String mutable_label = "before";
  mutable_label.* = "after";

  SumTo(69420, 10);

  stdout("Variable values:");
  stdout(state);
  stdout(total);
  stdout(delayed);
  stdout(counter);
  stdout(session);
  stdout(inferred);
  stdout(ratio);
  stdout(debt);
  stdout(status);
  stdout(mutable_label.*);
  stdout(showcase_name);

  -- Lists, tuples, maps, member access, and destructuring.
  local List names = ["Ada", "Grace", "Joe"];
  local Tuple identity = (42, "pilot");
  local Map profile = #(:name => "Terra", :version => 1);
  local RestrictedMap limited_profile = RestrictedMap(3, profile);
  local (Int id, String role) = identity;

  stdout(profile.name);
  stdout(profile.count);
  stdout(limited_profile.members);
  local ShowcasePlayer player = ShowcasePlayer("Ada", 7);
  local ShowcasePlayer updated_player = player{ score = 8 };
  local Map updated_profile = profile{ :version => 2 };
  local RestrictedMap updated_limited_profile = limited_profile{ :mode => "demo" };
  local ShowcaseStatus player_status = ShowcaseStatus.Ready(player.score);
  stdout(player.name);
  stdout(player.score);
  stdout(updated_player.score);
  stdout(updated_profile.version);
  stdout(updated_limited_profile.count);
  stdout(player_status.tag);

  -- Safe conversion helpers.
  local Int parsed_port = parse_int("8080");
  local Float parsed_ratio = parse_float("0.5");
  local Number parsed_count = parse_number("42");
  stdout(to_string(parsed_port));
  stdout(to_binary(:ready));
  stdout(to_string(parsed_ratio));
  stdout(parsed_count);

  if player_status == {
    case ShowcaseStatus.Ready(bind code):
      stdout(code);
    case ShowcaseStatus.Failed(bind message):
      stdout(message);
    case ShowcaseStatus.Waiting():
      stdout("waiting");
    case:
      stdout("unknown status");
  }
  stdout(id);
  stdout(role);

  -- Multiple function return values assigned to typed variables.
  local String category, Number doubled = Analyze(total);
  local Int piped = 5 |> Increment() |> Increment();
  local Int checked = try Increment(piped);
  stdout(category);
  stdout(doubled);
  stdout(checked);

  -- if / elseif / else.
  if total > 10 {
    stdout("total is large");
  } elseif total == 7 {
    stdout("total is exactly seven");
  } else {
    stdout("total is small");
  }

  -- unless / else.
  unless enabled {
    stdout("disabled");
  } else {
    stdout("enabled");
  }

  -- Exhaustive switch with break-by-default cases.
  if category == {
    case "large":
      stdout("switch selected large");
    case "medium":
      stdout("switch selected medium");
    case:
      stdout("switch selected the default");
  }

  -- Case expressions may call functions and are checked in source order.
  if total == {
    case Increment(6):
      stdout("switch matched a function result");
    case:
      stdout("switch used its default");
  }

  -- Iterate over a collection with a named item and implicit it index.
  for_each name in names {
    stdout(it);
    stdout(name);
  }

  -- Range, while, and do_while loops all expose it.
  for range(3) {
    stdout(it);
  }

  while it < 2 {
    stdout(it);
  }

  do_while it < 1 {
    stdout(it)
  }

  -- Recursive function calls execute as ordinary BEAM calls.
  stdout(Factorial(5));
  stdout(SumTo(5, 0));

  -- Character literals use Erlang-compatible integer characters.
  stdout('T');

  return *SInt(SInt(doubled));
  -- stdout(""); // this is a bad reporting if the statement shown here is wrong when printing error
}
