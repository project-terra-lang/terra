function SInt OpenCalculus(SInt Range) 
{
    local SInt number = Range;
    // bug with SInt (below code fails)
    // return 0;

    if number == {
        case -0:
            return -0;
        case -100:
            return -100;
        case:
            OpenCalculus(Range - 1);
    }

    return number;
}



