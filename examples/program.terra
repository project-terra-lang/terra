function SInt StopAt() {
    return -100;
}

function SInt OpenCalculus(SInt Range) {
    local SInt number = Range;

    if number == {
        case StopAt():
            local SInt value = StopAt();
            return value;
        case -100:
            return -100;
        case:
            return OpenCalculus(Range - 1);
    }
}

function Number Main(String Args) {
    stdout(try OpenCalculus(1000));
    return 69420;
}
