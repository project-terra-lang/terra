enum Result {
    variant Ok(Int value);
    variant Error(String message);
    variant Pending;
}

function Result Load(Bool ready) {
    if ready {
        return Result.Ok(7);
    } else {
        return Result.Error("not ready");
    }
}

function Number Main(String Args) {
    local Result result = Load(true);
    local Result pending = Result.Pending();
    stdout(pending.tag);

    if result == {
        case Result.Ok(bind value):
            stdout(Args);
            return value;
        case Result.Error(bind message):
            stdout(message);
            return -1;
        case Result.Pending():
            return 0;
        case:
            return 0;
    }
}
