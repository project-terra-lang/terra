function Float Ratio(Int total, SInt delta) {
    return (total + delta) / 2;
}

function Bool Below(Int value, Float limit) {
    return value < limit;
}

function strict *SInt Main(*String Args) {
    if Below(2, 2.5) {
        return *SInt(Ratio(6, -1));
    } else {
        return *SInt(Int(0.0));
    }
}
