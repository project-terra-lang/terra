struct Wrapper {
    Inner inner;

    enum Status {
        Ready;
        Down(String reason);
    }

    struct Inner {
        Status status;
    }
}

function strict *SInt Main(*String Args) {
    local Inner inner = Inner(Status.Down(Args.*));
    local Wrapper wrapper = Wrapper(inner);

    if wrapper.inner.status == {
        case Status.Ready():
            return *SInt(1);
        case Status.Down(bind reason):
            stdout(reason);
            return *SInt(2);
        case:
            return *SInt(0);
    }
}
